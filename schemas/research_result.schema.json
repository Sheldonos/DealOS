{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchResult",
  "type": "object",
  "required": [
    "summary",
    "facts",
    "sources"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}