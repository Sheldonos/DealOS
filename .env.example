# ---------- Domains / owner ----------
OWNER_EMAIL=REQUIRED_owner@example.com
DEALOS_DOMAIN=dealos.example.com
N8N_DOMAIN=n8n.example.com
GENERIC_TIMEZONE=America/New_York

# ---------- Internal security ----------
DEALOS_API_KEY=REQUIRED_generate_64_hex_chars
N8N_ENCRYPTION_KEY=REQUIRED_generate_64_hex_chars

# ---------- Database ----------
# Production: Supabase/Postgres pooled/server connection, SSL required.
DATABASE_URL=REQUIRED_postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# ---------- OpenAI ----------
OPENAI_API_KEY=REQUIRED
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_STANDARD_MODEL=gpt-5.6-terra
OPENAI_HIGH_MODEL=gpt-5.6-sol
OPENAI_DAILY_BUDGET_USD=15
OPENAI_MONTHLY_BUDGET_USD=300
# Current public web-search tool-call price is $10/1k calls; keep configurable.
OPENAI_WEB_SEARCH_COST_PER_CALL_USD=0.01

# ---------- Manus (optional) ----------
MANUS_ENABLED=false
MANUS_API_KEY=
MANUS_BASE_URL=https://api.manus.ai
MANUS_PROFILE=manus-1.6-lite
MANUS_MIN_EXPECTED_VALUE_USD=25000
MANUS_WEBHOOK_URL=https://dealos.example.com/hooks/manus

# ---------- Contact discovery (private-market lane) ----------
HUNTER_ENABLED=false
HUNTER_API_KEY=
HUNTER_MIN_OPPORTUNITY_SCORE=70
# Apollo is an optional upgrade/fallback; not required by v1 core.
APOLLO_ENABLED=false
APOLLO_API_KEY=

# ---------- Autonomous outbound enablement ----------
# Keep false until business_profile.yaml is completed and test sends pass.
OUTREACH_AUTONOMOUS_ENABLED=false
PRIVATE_MARKET_SCANS_ENABLED=false

# ---------- Government discovery ----------
SAM_API_KEY=REQUIRED_for_government_lane
SAM_NAICS=
SAM_SET_ASIDE=
SAM_NOTICE_TYPES=

# ---------- Google Workspace ----------
# OAuth client credentials are stored in n8n, NOT here.
GOOGLE_DEALOS_INBOX=deals@example.com
GOOGLE_DRIVE_DEALOS_FOLDER_ID=REQUIRED
MEETING_MIN_NOTICE_HOURS=24
MEETING_MAX_DAYS_AHEAD=30
MEETING_DEFAULT_DURATION_MIN=30

# ---------- Stripe (optional until billing enabled) ----------
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_CURRENCY=usd

# ---------- DocuSign (optional until signatures enabled) ----------
DOCUSIGN_ENABLED=false
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_BASE_URL=https://account-d.docusign.com
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY_PATH=/run/secrets/docusign_private_key.pem

# ---------- Autonomous outreach ----------
OUTBOUND_FIRST_TOUCH_MAX_PER_DAY=40
OUTBOUND_TOTAL_MAX_PER_DAY=120
OUTBOUND_MAX_FOLLOWUPS=3
OUTBOUND_MIN_MINUTES_BETWEEN_MESSAGES=2

# ---------- Financial / approval guardrails ----------
OWNER_SIGNATURE_REQUIRED=true
AUTONOMOUS_MONEY_MOVEMENT_ENABLED=false
BINDING_COMMITMENT_OWNER_APPROVAL_USD=0
HIGH_VALUE_DEAL_USD=100000
FEDERAL_CONTINGENT_FEE_ENABLED=false
