{
  "name": "DealOS 03 - SAM Opportunity Scan",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "sched",
      "name": "Hourly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const now=new Date(); const from=new Date(now.getTime()-48*3600*1000); const fmt=d=>String(d.getMonth()+1).padStart(2,'0')+'/'+String(d.getDate()).padStart(2,'0')+'/'+d.getFullYear(); return [{json:{postedFrom:fmt(from),postedTo:fmt(now)}}];"
      },
      "id": "dates",
      "name": "Date Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://api.sam.gov/opportunities/v2/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "api_key",
              "value": "={{$env.SAM_API_KEY}}"
            },
            {
              "name": "postedFrom",
              "value": "={{$json.postedFrom}}"
            },
            {
              "name": "postedTo",
              "value": "={{$json.postedTo}}"
            },
            {
              "name": "limit",
              "value": "1000"
            },
            {
              "name": "offset",
              "value": "0"
            }
          ]
        },
        "options": {}
      },
      "id": "sam",
      "name": "SAM Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return ($json.opportunitiesData || []).map(x => ({json:{source:\"sam\",external_id:String(x.noticeId || x.solicitationNumber || \"\"),title:x.title || \"Untitled SAM opportunity\",url:x.uiLink || x.additionalInfoLink || null,description:x.description || null,raw:x}})).filter(x=>x.json.external_id);"
      },
      "id": "norm",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.DEALOS_INTERNAL_URL + \"/events/opportunity\"}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-DealOS-Key",
              "value": "={{$env.DEALOS_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{JSON.stringify($json)}}",
        "options": {}
      },
      "id": "ingest",
      "name": "Ingest Opportunity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        840,
        0
      ]
    }
  ],
  "connections": {
    "Hourly": {
      "main": [
        [
          {
            "node": "Date Window",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Date Window": {
      "main": [
        [
          {
            "node": "SAM Search",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SAM Search": {
      "main": [
        [
          {
            "node": "Normalize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize": {
      "main": [
        [
          {
            "node": "Ingest Opportunity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "versionId": "00000000-0000-0000-0000-000000000001",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}